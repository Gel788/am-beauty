SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AM Beauty <noreply@ambeauty-cosmetica.ru>

# Payment (optional — demo mode without keys)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
